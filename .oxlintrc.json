{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react-hooks/exhaustive-deps": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/target/**",
    ".worktrees/**"
  ],
  "overrides": [
    {
      "files": [
        "src/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/server/*",
                  "**/server"
                ],
                "message": "The browser bundle and the CLI must not pull in server code. Move what both sides need into shared/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "shared/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/server/*",
                  "**/server"
                ],
                "message": "The browser bundle and the CLI must not pull in server code. Move what both sides need into shared/."
              },
              {
                "regex": "^node:",
                "message": "shared/ runs in the browser too, so it cannot use Node built-ins."
              }
            ]
          }
        ]
      }
    }
  ]
}
